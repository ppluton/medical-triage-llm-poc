{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "chsa-triage-poc",
  "pages_build_output_dir": "./dist",
  "compatibility_date": "2026-09-16",
  "compatibility_flags": ["nodejs_compat"],
  "observability": {
    "enabled": true,
    "head_sampling_rate": 1
  },
  "vars": {
    "DEMO_ENVIRONMENT": "pilot"
  }
}

{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/ppluton/medical-train-llm/schemas/source_medical_qa_sft_v1.schema.json",
  "title": "Source-derived medical QA SFT record v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "record_id", "task_type", "language", "instruction", "response", "source", "transformation", "quality", "split", "intended_use", "triage_label"],
  "properties": {
    "schema_version": {"const": "1.0.0"},
    "record_id": {"type": "string", "pattern": "^sft-source-[a-f0-9]{24}$"},
    "task_type": {"const": "medical_qa_sft"},
    "language": {"enum": ["fr", "en"]},
    "instruction": {"type": "string", "minLength": 1, "maxLength": 4000},
    "response": {"type": "string", "minLength": 1, "maxLength": 4000},
    "source": {
      "type": "object",
      "additionalProperties": false,
      "required": ["source_manifest_id", "source_dataset", "source_license", "source_record_id", "source_locator"],
      "properties": {
        "source_manifest_id": {"enum": ["src-medquad-577bd37", "src-mediqal-5af3494", "src-frenchmedmcqa-deft-2023-full"]},
        "source_dataset": {"enum": ["abachaa/MedQuAD", "ANR-MALADES/MediQAl", "qanastek/frenchmedmcqa"]},
        "source_license": {"enum": ["CC-BY-4.0", "Apache-2.0"]},
        "source_record_id": {"type": "string", "minLength": 1},
        "source_locator": {"type": "string", "minLength": 1}
      }
    },
    "transformation": {
      "type": "object",
      "additionalProperties": false,
      "required": ["pipeline_name", "pipeline_version", "operations", "content_truncated", "code_revision", "run_id"],
      "properties": {
        "pipeline_name": {"const": "source_medical_qa_sft"},
        "pipeline_version": {"const": "1.0.0"},
        "operations": {"const": ["deterministic_selection", "exact_normalized_question_deduplication", "presidio_direct_identifier_anonymization"]},
        "content_truncated": {"type": "boolean"},
        "code_revision": {"type": "string", "minLength": 7},
        "run_id": {"type": "string", "minLength": 1}
      }
    },
    "quality": {
      "type": "object",
      "additionalProperties": false,
      "required": ["pii_anonymization_status", "answer_origin", "clinical_review_status"],
      "properties": {
        "pii_anonymization_status": {"const": "passed_direct_identifiers_only"},
        "answer_origin": {"const": "source_provided"},
        "clinical_review_status": {"const": "not_performed"}
      }
    },
    "split": {"enum": ["train", "validation", "test"]},
    "intended_use": {"const": "medical_domain_adaptation_for_triage_poc"},
    "triage_label": {"type": "null"}
  }
}
